<Window x:Class="SPJ_APP.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - SPJ APP" Height="520" Width="480" WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Border Background="White" CornerRadius="14" Padding="32,24" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.08"/>
            </Border.Effect>
            
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center">
                    <!-- App Logo & Branding Header -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Image Source="/Assets/logo_spj.png" Height="72" Width="72" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                        <TextBlock Text="CV. Sarana Prima Jaya" FontSize="18" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sistem Manajemen ERP &amp; POS Desktop" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Input User -->
                    <TextBlock Text="Nama User / Akun" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <ComboBox x:Name="InputNama" Margin="0,0,0,14" DisplayMemberPath="Name" IsEditable="True" MinHeight="38" Padding="8,6" VerticalContentAlignment="Center"/>

                    <!-- Input Password -->
                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="InputPassword" Margin="0,0,0,16" KeyDown="InputPassword_KeyDown" MinHeight="38" Padding="8,6" VerticalContentAlignment="Center"/>


                    <!-- Error / Info Status Text -->
                    <TextBlock x:Name="TeksStatus" Foreground="#DC2626" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" HorizontalAlignment="Center"/>

                    <!-- Submit Button -->
                    <Button x:Name="TombolLogin" Content="Masuk ke Aplikasi" Height="44" FontSize="14" FontWeight="Bold" Click="TombolLogin_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
