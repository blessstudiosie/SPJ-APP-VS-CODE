<Window x:Class="SPJ_APP.View.PaymentFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catat Pembayaran" Height="380" Width="360" WindowStartupLocation="CenterOwner">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}"/>
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="ShortcutSave_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="ShortcutClose_Executed"/>
    </Window.CommandBindings>
    <StackPanel Margin="15">
        <TextBlock x:Name="TeksInfoNota" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock x:Name="TeksSisaTagihan" Margin="0,0,0,15" Foreground="DarkRed"/>

        <TextBlock Text="Jumlah Bayar"/>
        <TextBox x:Name="InputJumlah" Margin="0,2,0,10" TextChanged="InputJumlah_TextChanged"/>

        <TextBlock Text="Metode Pembayaran"/>
        <ComboBox x:Name="InputMetode" Margin="0,2,0,10">
            <ComboBoxItem Content="Tunai"/>
            <ComboBoxItem Content="Transfer"/>
            <ComboBoxItem Content="Lainnya"/>
        </ComboBox>

        <TextBlock Text="Catatan (opsional)"/>
        <TextBox x:Name="InputCatatan" Margin="0,2,0,15" TextWrapping="Wrap" AcceptsReturn="True" Height="50"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TombolBatal" Content="Batal" Padding="15,5" Margin="0,0,10,0" Click="TombolBatal_Click"/>
            <Button x:Name="TombolSimpan" Content="Simpan" Padding="15,5" Click="TombolSimpan_Click"/>
        </StackPanel>
    </StackPanel>
</Window>