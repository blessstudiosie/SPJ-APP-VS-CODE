<Window x:Class="SPJ_APP.View.ProductFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Form Produk"
        Height="530"
        Width="420"
        WindowStartupLocation="CenterOwner">
        <Window.InputBindings>
    <KeyBinding Key="Enter" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}"/>
    <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}"/>
</Window.InputBindings>
<Window.CommandBindings>
    <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="ShortcutSave_Executed"/>
    <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="ShortcutClose_Executed"/>
</Window.CommandBindings>
        <ScrollViewer Margin="15">
                <StackPanel>
                        <TextBlock Text="Nama Produk"/>
                        <TextBox x:Name="InputName"
                                 Margin="0,2,0,10"/>

                        <TextBlock Text="Kategori"/>
                        <ComboBox x:Name="InputKategori"
                                  Margin="0,2,0,10"
                                  IsEditable="True"/>

                        <TextBlock Text="Satuan Kecil (misal: PCS)"/>
                        <TextBox x:Name="InputSatuan"
                                 Margin="0,2,0,10"/>

                        <TextBlock Text="Satuan Besar (misal: DUS)"/>
                        <ComboBox x:Name="InputSatuanBesar"
                                  Margin="0,2,0,10"
                                  IsEditable="True"/>

                        <TextBlock Text="Qty Ratio (isi satuan kecil per satuan besar)"/>
                        <TextBox x:Name="InputQtyRatio"
                                 Margin="0,2,0,10"/>

                        <TextBlock Text="Harga R"/>
                        <TextBox x:Name="InputHargaR"
                                        Margin="0,2,0,10"
                                        TextChanged="InputHarga_TextChanged"/>

                        <TextBlock Text="Harga SG"/>
                        <TextBox x:Name="InputHargaSg"
                                        Margin="0,2,0,10"
                                        TextChanged="InputHarga_TextChanged"/>

                        <TextBlock Text="Harga G"/>
                        <TextBox x:Name="InputHargaG"
                                        Margin="0,2,0,10"
                                        TextChanged="InputHarga_TextChanged"/>

                        <TextBlock Text="Harga P"/>
                        <TextBox x:Name="InputHargaP"
                                        Margin="0,2,0,10"
                                        TextChanged="InputHarga_TextChanged"/>

                        <TextBlock Text="Status"/>
                        <ComboBox x:Name="InputStatus"
                                  Margin="0,2,0,10">
                                <ComboBoxItem Content="Y"/>
                                <ComboBoxItem Content="N"/>
                        </ComboBox>

                        <TextBlock Text="Deskripsi"/>
                        <TextBox x:Name="InputDescription"
                                 Margin="0,2,0,5"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="50"/>
                        <Button x:Name="TombolIsiOtomatis"
                                Content="Isi Otomatis"
                                HorizontalAlignment="Left"
                                Padding="8,3"
                                Margin="0,0,0,10"
                                Click="TombolIsiOtomatis_Click"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                                <Button x:Name="TombolBatal"
                                        Content="Batal"
                                        Padding="15,5"
                                        Margin="0,0,10,0"
                                        Click="TombolBatal_Click"/>
                                <Button x:Name="TombolSimpan"
                                        Content="Simpan"
                                        Padding="15,5"
                                        Click="TombolSimpan_Click"/>
                        </StackPanel>
                </StackPanel>
        </ScrollViewer>
</Window>