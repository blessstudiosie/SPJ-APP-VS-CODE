<Window x:Class="SPJ_APP.View.ConflictResolutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Penyelesaian Konflik Data" Height="500" Width="700" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="15">
        <TextBlock DockPanel.Dock="Top" Text="Data berikut diubah di dua tempat sekaligus. Pilih versi mana yang ingin dipakai:" 
                   TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="Bold"/>
        <Button DockPanel.Dock="Bottom" Content="Tutup" HorizontalAlignment="Right" Padding="15,5" Margin="0,10,0,0" Click="TombolTutup_Click"/>
        <ScrollViewer>
            <ItemsControl x:Name="DaftarKonflik">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,10" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="Versi Saya (Lokal)" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding LocalSummary}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="Versi Server" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ServerSummary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Pakai Data Saya" Padding="10,5" Margin="0,0,10,0" 
                                            Tag="{Binding}" Click="PakaiLokal_Click"/>
                                    <Button Content="Pakai Data Server" Padding="10,5" 
                                            Tag="{Binding}" Click="PakaiServer_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>