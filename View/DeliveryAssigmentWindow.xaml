<Window x:Class="SPJ_APP.View.DeliveryAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buat Nota Pengiriman" Height="420" Width="480" WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="🚚 Penugasan Armada Pengiriman" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock x:Name="TeksJumlahNota" Text="0 nota akan dimasukkan ke pengiriman ini." Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="👨‍✈️ Sopir / Pengemudi" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                <ComboBox x:Name="InputSopir" Height="32" Margin="0,4,0,12" DisplayMemberPath="Name" VerticalContentAlignment="Center" Padding="6,2"/>

                <TextBlock Text="👥 Helper (Opsional)" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                <ComboBox x:Name="InputHelper" Height="32" Margin="0,4,0,12" DisplayMemberPath="Name" VerticalContentAlignment="Center" Padding="6,2"/>

                <TextBlock Text="🔍 Checker (Penanggung Jawab Stock/Muat)" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                <ComboBox x:Name="InputChecker" Height="32" Margin="0,4,0,0" DisplayMemberPath="Name" VerticalContentAlignment="Center" Padding="6,2"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TombolBatal" Content="Batal" Padding="14,6" Height="34" Margin="0,0,8,0" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" FontWeight="SemiBold" Cursor="Hand" Click="TombolBatal_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="TombolBuat" Content="💾 Buat Pengiriman" Padding="14,6" Height="34" Margin="0,0,8,0" Background="#4F46E5" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="TombolBuat_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="TombolBuatDanCopyWa" Content="📋 Buat &amp; Copy WA" Padding="14,6" Height="34" Background="#16A34A" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="TombolBuatDanCopyWa_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>