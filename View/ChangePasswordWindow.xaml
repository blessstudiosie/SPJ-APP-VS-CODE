<Window x:Class="SPJ_APP.View.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ubah Password Akun" Height="480" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Background="#EEF2FF" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                        <TextBlock Text="🔑" FontSize="18"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ubah Password Akun" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Perbarui kata sandi login untuk keamanan akun Anda." FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>
                <Separator Margin="0,14,0,0" Background="#E2E8F0"/>
            </StackPanel>

            <!-- Form Section -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!-- Logged In User Info -->
                <TextBlock Text="Pengguna Aktif:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤 " FontSize="13"/>
                        <TextBlock x:Name="TeksNamaUser" Text="Akun User" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

                <!-- Password Lama -->
                <TextBlock Text="Password Lama" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>
                <PasswordBox x:Name="InputPasswordLama" Height="36" Margin="0,0,0,14"/>

                <!-- Password Baru -->
                <TextBlock Text="Password Baru" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>
                <PasswordBox x:Name="InputPasswordBaru" Height="36" Margin="0,0,0,14"/>

                <!-- Konfirmasi Password Baru -->
                <TextBlock Text="Konfirmasi Password Baru" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>
                <PasswordBox x:Name="InputKonfirmasiPassword" Height="36" Margin="0,0,0,10"/>

                <!-- Status Feedback Message -->
                <TextBlock x:Name="TeksStatus" Text="" Foreground="#EF4444" FontSize="12" FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,10"/>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="TombolBatal" Grid.Column="0" Content="Batal" Height="38" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Click="TombolBatal_Click"/>
                <Button x:Name="TombolSimpan" Grid.Column="2" Content="Simpan Password" Height="38" Click="TombolSimpan_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
