<Window x:Class="SPJ_APP.View.ImportDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impor Data dari CSV" Height="450" Width="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="1. Pilih Tipe Data untuk diimpor:"/>
            <ComboBox x:Name="ComboBoxTipeData" Margin="0,5,0,0" SelectionChanged="ComboBoxTipeData_SelectionChanged"/>
        </StackPanel>

        <TextBlock x:Name="LabelTipeData" Grid.Row="1" Text="Impor Data" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <Border x:Name="BorderFormat" Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="2. Pastikan file CSV Anda memiliki format kolom berikut:" TextWrapping="Wrap"/>
                <TextBlock x:Name="FormatColumns" Text="" FontWeight="Bold" FontFamily="Consolas" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button x:Name="ButtonPilihFile" Content="3. Pilih File CSV..." Padding="10,5" Click="ButtonPilihFile_Click" IsEnabled="False"/>
            <TextBlock x:Name="TextBlockNamaFile" Text="Tidak ada file yang dipilih." VerticalAlignment="Center" Margin="10,0,0,0" FontStyle="Italic"/>
        </StackPanel>

        <ProgressBar x:Name="ProgressBarImpor" Grid.Row="4" Height="10" Margin="0,10,0,0" IsIndeterminate="False"/>

        <ScrollViewer Grid.Row="5" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="TextBlockHasil" Text="Hasil impor akan ditampilkan di sini." TextWrapping="Wrap"/>
        </ScrollViewer>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ButtonMulaiImpor" Content="Mulai Impor" Padding="15,5" IsEnabled="False" Click="ButtonMulaiImpor_Click"/>
            <Button Content="Tutup" IsCancel="True" Padding="15,5" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
