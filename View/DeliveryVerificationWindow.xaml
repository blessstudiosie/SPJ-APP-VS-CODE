<Window x:Class="SPJ_APP.View.DeliveryVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verifikasi Barang Terkirim" Height="600" Width="700" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sesuaikan Qty Kirim per item. Kosongkan/isi 0 kalau barang dibatalkan seluruhnya."
                   TextWrapping="Wrap" Margin="0,0,0,10" FontStyle="Italic"/>

        <DataGrid x:Name="TabelVerifikasi" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  AlternatingRowBackground="#F5F5F5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No Nota" Binding="{Binding Nota}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Produk" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Qty Nota" Binding="{Binding OriginalQty, StringFormat={}{0:N0}}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Qty Kirim (Aktual)" Binding="{Binding ActualQtyText, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="TombolBatal" Content="Batal" Padding="15,5" Margin="0,0,10,0" Click="TombolBatal_Click"/>
            <Button x:Name="TombolKonfirmasi" Content="Konfirmasi" Padding="15,5" Click="TombolKonfirmasi_Click"/>
        </StackPanel>
    </Grid>
</Window>