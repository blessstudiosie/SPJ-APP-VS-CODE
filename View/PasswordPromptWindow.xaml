<Window x:Class="SPJ_APP.View.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔐 Otorisasi Password Manager / Owner" Height="260" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Icon & Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Background="#FEF2F2" CornerRadius="10" Width="42" Height="42" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Konfirmasi Otorisasi Pengaman" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock x:Name="TeksDeskripsiAksi" Text="Memerlukan verifikasi password Manager / Owner." FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Silakan masukkan password akun Manager / Owner / Admin:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>

        <!-- Password Input Box -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="4" Height="40" VerticalAlignment="Top">
            <PasswordBox x:Name="PasswordBox" FontSize="14" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Padding="8,0"/>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Batal" Width="90" Height="34" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" BorderThickness="0" IsCancel="True" Click="CancelButton_Click" Margin="0,0,10,0"/>
            <Button Content="🔑 Konfirmasi" Width="120" Height="34" Background="#4F46E5" Foreground="White" FontWeight="Bold" IsDefault="True" Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
