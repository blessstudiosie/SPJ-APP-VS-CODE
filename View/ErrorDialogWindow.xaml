<Window x:Class="SPJ_APP.View.ErrorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding ErrorTitle}"
        Height="420" Width="600"
        MinHeight="250" MinWidth="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="🚨 Terjadi Kesalahan Sistem" FontSize="16" FontWeight="Bold" Foreground="#DC2626"/>
            <TextBlock Text="Detail error di bawah ini dapat disalin dan dikirimkan ke Developer untuk perbaikan:" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
        </StackPanel>

        <TextBox Grid.Row="1"
                 Text="{Binding ErrorMessage}"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"
                 FontFamily="Consolas, Courier New"
                 FontSize="12"
                 Padding="10"
                 Background="#F8FAFC"
                 BorderBrush="#CBD5E1"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCopy"
                    Content="📋 Salin Detail Error ke Clipboard"
                    Padding="14,8"
                    Margin="0,0,8,0"
                    Click="CopyButton_Click"/>
            <Button Content="Tutup"
                    IsDefault="True"
                    IsCancel="True"
                    Padding="16,8"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
