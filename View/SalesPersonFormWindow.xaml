<Window x:Class="SPJ_APP.View.SalesPersonFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Form Sales" Height="400" Width="380" WindowStartupLocation="CenterOwner">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}"/>
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="ShortcutSave_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="ShortcutClose_Executed"/>
    </Window.CommandBindings>
    <StackPanel Margin="15">
        <TextBlock Text="Nama"/>
        <TextBox x:Name="InputName" Margin="0,2,0,10"/>

        <TextBlock Text="Telepon"/>
        <TextBox x:Name="InputPhone" Margin="0,2,0,10"/>

        <TextBlock Text="Email"/>
        <TextBox x:Name="InputEmail" Margin="0,2,0,10"/>

        <TextBlock Text="Role"/>
        <ComboBox x:Name="InputRole" Margin="0,2,0,10">
            <ComboBoxItem Content="SALES"/>
            <ComboBoxItem Content="MANAGER"/>
            <ComboBoxItem Content="ADMIN"/>
            <ComboBoxItem Content="OWNER"/>
            <ComboBoxItem Content="STAFF"/>
        </ComboBox>

        <TextBlock Text="Target Omset"/>
<TextBox x:Name="InputTargetOmset" Margin="0,2,0,10" TextChanged="InputAngka_TextChanged"/>

        <Grid Margin="0,10,0,0">
            <Button x:Name="TombolHapus" Content="🗑️ Hapus Sales" Height="34" Padding="12,5" HorizontalAlignment="Left" Background="#EF4444" Foreground="White" FontWeight="Bold" Visibility="Collapsed" Click="TombolHapus_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TombolBatal" Content="Batal" Height="34" Padding="15,5" Margin="0,0,10,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Click="TombolBatal_Click"/>
                <Button x:Name="TombolSimpan" Content="Simpan" Height="34" Padding="15,5" Click="TombolSimpan_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>