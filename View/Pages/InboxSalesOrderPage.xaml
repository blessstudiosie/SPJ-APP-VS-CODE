<UserControl x:Class="SPJ_APP.View.Pages.InboxSalesOrderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Inbox Sales Order (Mobile Queue)" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <ComboBox x:Name="ComboFilterStatus" Width="120" Margin="20,0,10,0" VerticalAlignment="Center" SelectionChanged="ComboFilterStatus_SelectionChanged">
                <ComboBoxItem Content="PENDING" IsSelected="True"/>
                <ComboBoxItem Content="APPROVED"/>
                <ComboBoxItem Content="REJECTED"/>
                <ComboBoxItem Content="SEMUA"/>
            </ComboBox>
            <Button x:Name="TombolRefresh" Content="Refresh Queue" Padding="12,5" Click="TombolRefresh_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Kiri: Daftar Antrian Sales Order -->
            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,0,10,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Daftar Antrian Pesanan" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <DataGrid x:Name="TabelQueue" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" AlternatingRowBackground="#F9F9F9"
                              SelectionChanged="TabelQueue_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Total Rp" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Waktu" Binding="{Binding CreatedAt, StringFormat=dd/MM HH:mm}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Panel Kanan: Detail Pesanan & Barang -->
            <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1" Padding="10">
                <Grid x:Name="PanelDetail" IsEnabled="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Detail Item Pesanan" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock x:Name="TeksInfoCustomer" Text="Customer: -" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TeksInfoWaktu" Text="Waktu Masuk: -" Foreground="#666666" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TeksInfoCatatan" Text="Catatan: -" Foreground="#444444" FontStyle="Italic" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- DataGrid Item Barang (Banyak Item) -->
                    <DataGrid x:Name="TabelItems" Grid.Row="2" AutoGenerateColumns="False"
                              CanUserAddRows="False" AlternatingRowBackground="#F9F9F9"
                              CellEditEnding="TabelItems_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nama Barang" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="70"/>
                            <DataGridTextColumn Header="Harga Satuan" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:N0}}" IsReadOnly="True" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="TombolHapusItem" Grid.Column="0" Content="Hapus Item Selected" Padding="10,6" Click="TombolHapusItem_Click"/>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock x:Name="TeksTotalGrand" Text="Total: Rp 0" FontSize="16" FontWeight="Bold" Foreground="#007ACC"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="TombolTolak" Content="Tolak (Reject)" Padding="15,6" Background="#FF4D4D" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Click="TombolTolak_Click"/>
                            <Button x:Name="TombolApprove" Content="Setujui (Approve)" Padding="15,6" Background="#28A745" Foreground="White" FontWeight="Bold" Click="TombolApprove_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
