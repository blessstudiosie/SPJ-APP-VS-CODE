<UserControl x:Class="SPJ_APP.View.Pages.ProductListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Daftar Produk" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Cari:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox x:Name="TeksPencarian" Width="150" VerticalAlignment="Center" TextChanged="TeksPencarian_TextChanged" />
            <TextBlock Text="Kategori:" VerticalAlignment="Center" Margin="10,0,5,0" />
            <ComboBox x:Name="ComboKategori" Width="120" VerticalAlignment="Center" SelectionChanged="ComboKategori_SelectionChanged" />
            <Button x:Name="TombolExportPdf" Content="Export PDF" Padding="10,5" Margin="10,0,0,0" Click="TombolExportPdf_Click"/>
            <Button x:Name="TombolTambah" Content="Tambah Produk" Padding="10,5" Margin="10,0,0,0" Click="TombolTambah_Click"/>
            <Button x:Name="TombolBarangMasuk" Content="Barang Masuk" Padding="10,5" Margin="10,0,0,0" Click="TombolBarangMasuk_Click"/>
            <Button x:Name="TombolOpname" Content="Stok Opname" Padding="10,5" Margin="10,0,0,0" Click="TombolOpname_Click"/>
            <TextBox x:Name="TeksStatus" VerticalAlignment="Center" Margin="15,0,0,0" FontStyle="Italic"
                     IsReadOnly="True" BorderThickness="0" Background="Transparent" IsReadOnlyCaretVisible="True"/>
        </StackPanel>

        <DataGrid x:Name="TabelProduk" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                  CanUserAddRows="False" AlternatingRowBackground="#F5F5F5"
                  MouseDoubleClick="TabelProduk_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nama Produk" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="100"/>
                <DataGridTextColumn Header="Stok Ready" Binding="{Binding StokReady, StringFormat={}{0:N0}}" Width="90"/>
                <DataGridTextColumn Header="Stok Fisik" Binding="{Binding StokFisik, StringFormat={}{0:N0}}" Width="90"/>
                <DataGridTextColumn Header="Satuan" Binding="{Binding Satuan}" Width="70"/>
                <DataGridTextColumn Header="Harga R" Binding="{Binding HargaR, StringFormat={}{0:N0}}" Width="90"/>
                <DataGridTextColumn Header="Harga SG" Binding="{Binding HargaSg, StringFormat={}{0:N0}}" Width="90"/>
                <DataGridTextColumn Header="Harga G" Binding="{Binding HargaG, StringFormat={}{0:N0}}" Width="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TeksJumlah" Grid.Row="3" Margin="0,10,0,0" FontWeight="Bold"/>
    </Grid>
</UserControl>