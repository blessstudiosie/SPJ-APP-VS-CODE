<UserControl x:Class="SPJ_APP.View.Pages.SalesPersonListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Title & Role Permission Badge -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="👥 Master Data Sales" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Kelola data tim sales, role akses, dan target omset per bulan." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>

            <Border x:Name="BadgeAksesManager" Grid.Column="1" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛡️ " FontSize="12"/>
                    <TextBlock x:Name="TeksAksesLevel" Text="Akses: Full (Manager / Owner)" FontSize="12" FontWeight="Bold" Foreground="#047857"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Action Bar & Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="TombolTambah" Grid.Column="0" Content="➕ Tambah Sales Baru" Padding="14,6" Height="36" Click="TombolTambah_Click"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Cari:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12.5" Foreground="#475569" FontWeight="Medium"/>
                <TextBox x:Name="InputCari" Width="200" Height="36" VerticalContentAlignment="Center" Padding="8,4" TextChanged="InputCari_TextChanged"/>
            </StackPanel>
        </Grid>

        <!-- Sales Data Table -->
        <DataGrid x:Name="TabelSales" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" AlternatingRowBackground="#F8FAFC" RowHeight="40"
                  MouseDoubleClick="TabelSales_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nama Sales" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Telepon" Binding="{Binding Phone}" Width="130"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                <DataGridTextColumn Header="Role Akses" Binding="{Binding Role}" Width="110"/>
                <DataGridTextColumn Header="Target Omset" Binding="{Binding TargetOmset, StringFormat={}{0:N0}}" Width="130"/>
                <DataGridTemplateColumn x:Name="KolomAksi" Header="Aksi Kelola" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content="📝 Edit" Padding="8,3" Margin="0,0,6,0" FontSize="11.5"
                                        Click="TombolEditRow_Click" Background="#EEF2FF" Foreground="#4F46E5" FontWeight="SemiBold"/>
                                <Button Content="🗑️ Hapus" Padding="8,3" FontSize="11.5"
                                        Click="TombolHapusRow_Click" Background="#FEF2F2" Foreground="#EF4444" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer Info -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TeksJumlah" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBlock x:Name="TeksStatus" Grid.Column="1" VerticalAlignment="Center" FontStyle="Italic" Foreground="#64748B"/>
        </Grid>
    </Grid>
</UserControl>