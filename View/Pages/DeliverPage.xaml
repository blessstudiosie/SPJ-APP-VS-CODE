<UserControl x:Class="SPJ_APP.View.Pages.DeliveryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <!-- Header Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="🚚 Log &amp; Jadwal Pengiriman (Expedisi)" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Kelola pengelompokan pengiriman nota berdasarkan jalur pengiriman, penugasan armada, dan status delivery." Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Group 1: Nota Siap Dikirim (ON PROSES) -->
        <GroupBox Grid.Row="1" Header="📦 Nota Siap Dikirim (Status: ON PROSES)" Margin="0,0,0,12" Background="White" BorderBrush="#E2E8F0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Filter Bar (Filter Jalur & Pencarian Customer/Nota) -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Jalur Pengiriman:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ComboFilterJalur" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Padding="8,4" SelectionChanged="ComboFilterJalur_SelectionChanged"/>

                    <TextBlock Grid.Column="2" Text="Pencarian:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="16,0,8,0"/>
                    <TextBox x:Name="TxtCariNota" Grid.Column="3" Height="32" Padding="8,5" VerticalContentAlignment="Center" TextChanged="TxtCariNota_TextChanged"/>
                </Grid>

                <!-- DataGrid Nota Siap Dikirim -->
                <DataGrid x:Name="TabelSiapKirim" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          AlternatingRowBackground="#F8FAFC" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name, StringFormat='🚚 Jalur Pengiriman: {0}'}" FontWeight="Bold" Foreground="#1E293B" Background="#E0E7FF" Padding="8,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Pilih" Binding="{Binding IsSelected, Mode=TwoWay}" Width="50"/>
                        <DataGridTextColumn Header="No Nota" Binding="{Binding Nota}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Customer / Toko" Binding="{Binding CustomerName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Sales Person" Binding="{Binding SalesPersonName}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Jalur Pengiriman" Binding="{Binding JalurPengiriman}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Total Nota" Binding="{Binding Total, StringFormat={}{0:N0}}" Width="120" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="TombolBuatPengiriman" Content="🚚 Buat Surat Pengiriman (Pilihan)" 
                            Padding="16,6" Height="34" Background="#4F46E5" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0" Click="TombolBuatPengiriman_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="TombolCopyWaSiapKirim" Content="📋 Copy ke WhatsApp" 
                            Padding="14,6" Height="34" Background="#22C55E" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="TombolCopyWaSiapKirim_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Group 2: Pengiriman Aktif (Dalam Perjalanan) -->
        <GroupBox Grid.Row="2" Header="🚚 Pengiriman Aktif (Dalam Perjalanan / Belum Ditutup)" Background="White" BorderBrush="#E2E8F0" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TabelPengirimanAktif">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="12" Background="#F8FAFC">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Delivery.DeliveryNumber, StringFormat='Surat Pengiriman: {0}'}" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                        <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding JumlahNota, StringFormat={}{0} Nota}" FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Margin="0,2,0,6" Foreground="#334155" FontSize="12.5">
                                        <Run Text="👨‍✈️ Sopir: "/><Run Text="{Binding DriverName}" FontWeight="Bold" Foreground="#0F172A"/>
                                        <Run Text=" | 👥 Helper: "/><Run Text="{Binding HelperName}" FontWeight="SemiBold" Foreground="#334155"/>
                                        <Run Text=" | 🔍 Checker: "/><Run Text="{Binding CheckerName}" FontWeight="SemiBold" Foreground="#334155"/>
                                    </TextBlock>

                                    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,4,0,10">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,2">
                                                        <Run Text="• " Foreground="#64748B"/>
                                                        <Run Text="{Binding Nota}" FontWeight="Bold" Foreground="#0F172A"/>
                                                        <Run Text=" - " Foreground="#94A3B8"/>
                                                        <Run Text="{Binding CustomerName}" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                        <Run Text=" (Sales: "/><Run Text="{Binding SalesPersonName}" Foreground="#475569"/><Run Text=")"/>
                                                        <Run Text=" [Jalur: "/><Run Text="{Binding JalurPengiriman}" Foreground="#6366F1"/><Run Text="]"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                                        <Button Content="✅ Selesaikan Pengiriman" Padding="12,6" Background="#16A34A" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0" Tag="{Binding}" Click="TombolSelesaikanDelivery_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Content="❌ Batalkan Pengiriman" Padding="12,6" Background="#EF4444" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0" Tag="{Binding}" Click="TombolBatalkanDelivery_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Content="📋 Copy WA" Padding="12,6" Background="#2563EB" Foreground="White" FontWeight="Bold" Cursor="Hand" Tag="{Binding}" Click="TombolCopyWaDelivery_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
