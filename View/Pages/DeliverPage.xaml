<UserControl x:Class="SPJ_APP.View.Pages.DeliveryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Log Pengiriman" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <GroupBox Grid.Row="1" Header="Nota Siap Dikirim (Status: ON PROSES)" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="TabelSiapKirim" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False"
                          AlternatingRowBackground="#F5F5F5">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Background="#E0E0E0" Padding="5,3"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Pilih" Binding="{Binding IsSelected, Mode=TwoWay}" Width="50"/>
                        <DataGridTextColumn Header="No Nota" Binding="{Binding Nota}" Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="160" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Jalur" Binding="{Binding JalurPengiriman}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N0}}" Width="110" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="TombolBuatPengiriman" Content="Buat Nota Pengiriman (untuk yang dipilih)" 
                            Padding="12,5" Margin="0,0,10,0" Click="TombolBuatPengiriman_Click"/>
                    <Button x:Name="TombolCopyWaSiapKirim" Content="Copy ke WhatsApp" 
                            Padding="12,5" Click="TombolCopyWaSiapKirim_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Pengiriman Aktif (Belum Ditutup)">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TabelPengirimanAktif">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,10" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Delivery.DeliveryNumber}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Margin="0,3,0,3">
                                        <Run Text="Sopir: "/><Run Text="{Binding DriverName}" FontWeight="SemiBold"/>
                                        <Run Text=" | Helper: "/><Run Text="{Binding HelperName}" FontWeight="SemiBold"/>
                                        <Run Text=" | Checker: "/><Run Text="{Binding CheckerName}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding JumlahNota, StringFormat='Jumlah Nota: {0}'}" Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Selesaikan Pengiriman" Padding="10,5" Margin="0,0,10,0" 
                                                Tag="{Binding}" Click="TombolSelesaikanDelivery_Click"/>
                                        <Button Content="Batalkan Pengiriman" Padding="10,5" Margin="0,0,10,0"
                                                Tag="{Binding}" Click="TombolBatalkanDelivery_Click"/>
                                        <Button Content="Copy ke WhatsApp" Padding="10,5" 
                                                Tag="{Binding}" Click="TombolCopyWaDelivery_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
