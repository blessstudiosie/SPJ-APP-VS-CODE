<UserControl x:Class="SPJ_APP.View.Pages.InboxVisitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Inbox Kunjungan Sales (Mobile Queue)" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <ComboBox x:Name="ComboFilterStatus" Width="120" Margin="20,0,10,0" VerticalAlignment="Center" SelectionChanged="ComboFilterStatus_SelectionChanged">
                <ComboBoxItem Content="PENDING" IsSelected="True"/>
                <ComboBoxItem Content="APPROVED"/>
                <ComboBoxItem Content="REJECTED"/>
                <ComboBoxItem Content="SEMUA"/>
            </ComboBox>
            <Button x:Name="TombolRefresh" Content="Refresh Queue" Padding="12,5" Click="TombolRefresh_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Kiri: Daftar Antrian Kunjungan -->
            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,0,10,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Daftar Antrian Kunjungan" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <DataGrid x:Name="TabelQueue" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" AlternatingRowBackground="#F9F9F9"
                              SelectionChanged="TabelQueue_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sales" Binding="{Binding SalesPersonName}" Width="110"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Baru?" Binding="{Binding IsNewCustomer}" Width="50"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Panel Kanan: Detail Kunjungan -->
            <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1" Padding="15">
                <Grid x:Name="PanelDetail" IsEnabled="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Detail Log Kunjungan" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock x:Name="TeksSales" Text="Sales: -" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TeksCustomer" Text="Customer: -" FontSize="14" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TeksIsNewCustomer" Text="Status Pelanggan: -" Foreground="#007ACC" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TeksWaktu" Text="Waktu Kunjungan: -" Foreground="#666666" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,15">
                        <TextBlock x:Name="TeksGPS" Text="Lokasi GPS: 0.0, 0.0" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Button x:Name="TombolBukaPeta" Content="Buka di Google Maps" Padding="10,3" Click="TombolBukaPeta_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,15">
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" Background="#F8F9FA" Padding="8">
                            <TextBlock x:Name="TeksCatatan" Text="-" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- Preview Foto -->
                    <Border Grid.Row="4" BorderBrush="#CCCCCC" BorderThickness="1" Background="#F0F0F0">
                        <Grid>
                            <Image x:Name="GambarFotoKunjungan" Stretch="Uniform" Margin="5"/>
                            <TextBlock x:Name="TeksFotoStatus" Text="Tidak ada foto kunjungan" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button x:Name="TombolTolak" Content="Tolak (Reject)" Padding="15,6" Background="#FF4D4D" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Click="TombolTolak_Click"/>
                        <Button x:Name="TombolApprove" Content="Setujui Kunjungan" Padding="15,6" Background="#28A745" Foreground="White" FontWeight="Bold" Click="TombolApprove_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
