<UserControl x:Class="SPJ_APP.View.Pages.InboxVisitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Search Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="📍 Log Kunjungan Sales (Mobile Check-in)" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Daftar riwayat kunjungan sales dari aplikasi mobile. Data tersimpan otomatis secara real-time dari lapangan." Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Input -->
                    <TextBox x:Name="TxtCari" 
                             Width="220" 
                             Height="34" 
                             Padding="8,5" 
                             Margin="0,0,10,0" 
                             TextChanged="TxtCari_TextChanged"/>
                    <Button x:Name="TombolRefresh" 
                            Content="🔄 Refresh Log Kunjungan" 
                            Padding="14,0" 
                            Height="34" 
                            Background="#EEF2FF" 
                            Foreground="#4F46E5" 
                            BorderBrush="#C7D2FE" 
                            FontWeight="Bold" 
                            Cursor="Hand" 
                            Click="TombolRefresh_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: Left Table & Right Detail Card -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.5*"/>
                <ColumnDefinition Width="5.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Kiri: Tabel Log Kunjungan -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="📋 Riwayat Kunjungan Sales" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,10"/>
                    <DataGrid x:Name="TabelQueue" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" AlternatingRowBackground="#F8FAFC" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                              SelectionChanged="TabelQueue_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Waktu" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="120"/>
                            <DataGridTextColumn Header="Sales Person" Binding="{Binding SalesPersonName}" Width="120"/>
                            <DataGridTextColumn Header="Customer / Toko" Binding="{Binding CustomerName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Panel Kanan: Detail Read-Only Kunjungan -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid x:Name="PanelDetail" IsEnabled="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="📌 Detail Log Kunjungan Field Sales" FontWeight="Bold" FontSize="16" Foreground="#0F172A" Margin="0,0,0,14"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock x:Name="TeksSales" Text="Sales: -" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock x:Name="TeksCustomer" Text="Customer: -" FontSize="14" Foreground="#334155" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TeksIsNewCustomer" Text="Status Pelanggan: -" Foreground="#2563EB" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TeksWaktu" Text="Waktu Kunjungan: -" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock x:Name="TeksGPS" Text="Lokasi GPS: 0.0, 0.0" VerticalAlignment="Center" Foreground="#475569" FontWeight="Medium" Margin="0,0,12,0"/>
                        <Button x:Name="TombolBukaPeta" Content="🗺️ Buka Google Maps" Padding="10,4" Height="28" Background="#F1F5F9" Foreground="#1E293B" BorderBrush="#CBD5E1" FontWeight="SemiBold" Cursor="Hand" Click="TombolBukaPeta_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,14">
                        <TextBlock Text="Catatan Field Visit:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" Background="#F8FAFC" CornerRadius="6" Padding="10">
                            <TextBlock x:Name="TeksCatatan" Text="-" TextWrapping="Wrap" Foreground="#334155"/>
                        </Border>
                    </StackPanel>

                    <!-- Preview Foto Kunjungan -->
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="Foto Kunjungan Lapangan:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="#F1F5F9" CornerRadius="8" Height="220">
                            <Grid>
                                <Image x:Name="GambarFotoKunjungan" Stretch="Uniform" Margin="6"/>
                                <TextBlock x:Name="TeksFotoStatus" Text="Tidak ada foto kunjungan" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8" FontWeight="Medium"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
