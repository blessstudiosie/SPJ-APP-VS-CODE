<UserControl x:Class="SPJ_APP.View.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <TextBlock Text="Alur Kerja Penjualan" FontSize="26" FontWeight="Bold" Foreground="#1F2937"/>
            <TextBlock Text="Ikuti urutan ini agar status nota, stok, pengiriman, dan pembayaran selalu konsisten." Margin="0,6,0,28" Foreground="#4B5563" FontSize="14"/>

            <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="1. Tambah Penjualan" FontWeight="Bold" FontSize="17" Foreground="#1D4ED8"/>
                    <TextBlock Text="Buat nota dan masukkan detail barang. Status awal: SO." Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="↓" HorizontalAlignment="Center" FontSize="24" Foreground="#6B7280"/>
            <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,10">
                <StackPanel>
                    <TextBlock Text="2. Cetak Nota" FontWeight="Bold" FontSize="17" Foreground="#C2410C"/>
                    <TextBlock Text="Cetak nota untuk memproses pesanan. Status menjadi ON PROSES dan Stok Ready berkurang." Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock Text="↓" HorizontalAlignment="Center" FontSize="24" Foreground="#6B7280"/>
            <Border Background="#F5F3FF" BorderBrush="#C4B5FD" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,10">
                <StackPanel>
                    <TextBlock Text="3. Buat Pengiriman" FontWeight="Bold" FontSize="17" Foreground="#6D28D9"/>
                    <TextBlock Text="Masukkan nota ON PROSES ke log pengiriman. Status menjadi DALAM PENGIRIMAN dan detail nota terkunci." Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock Text="↓" HorizontalAlignment="Center" FontSize="24" Foreground="#6B7280"/>
            <Border Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,10">
                <StackPanel>
                    <TextBlock Text="4. Konfirmasi Pengiriman" FontWeight="Bold" FontSize="17" Foreground="#047857"/>
                    <TextBlock Text="Konfirmasi barang diterima seluruhnya atau sesuaikan barang yang ditolak. Jika masih ada tagihan, status menjadi TEMPO." Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock Text="↓" HorizontalAlignment="Center" FontSize="24" Foreground="#6B7280"/>
            <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="5. Catat Pembayaran" FontWeight="Bold" FontSize="17" Foreground="#15803D"/>
                    <TextBlock Text="Pembayaran dicatat untuk nota TEMPO. Saat sisa tagihan menjadi 0, status otomatis menjadi DONE." Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
