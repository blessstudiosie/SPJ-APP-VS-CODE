<UserControl x:Class="SPJ_APP.View.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Judul Beranda -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Selamat Datang di SPJ APP" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Ringkasan data dan akses pintas menu utama aplikasi" FontSize="12" Foreground="Gray" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Group Ringkasan Data -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Omset Bulan Ini -->
            <GroupBox Header="Omset Bulan Ini" Grid.Column="0" Padding="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TeksOmsetBulanIni" Text="Rp 0" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TeksBulanKirim" Text="Tanggal Kirim: Bulan Ini" HorizontalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Card 2: Total Produk -->
            <GroupBox Header="Total Produk" Grid.Column="2" Padding="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TeksTotalProduk" Text="0" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Item Terdaftar" HorizontalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Card 3: Stok Ready -->
            <GroupBox Header="Total Stok Ready" Grid.Column="4" Padding="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TeksStokReady" Text="0" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Siap Diproses" HorizontalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Card 4: Stok Fisik -->
            <GroupBox Header="Total Stok Fisik" Grid.Column="6" Padding="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TeksStokFisik" Text="0" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Tersedia di Gudang" HorizontalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Panel Akses Cepat & Informasi -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Akses Cepat" Grid.Column="0" Padding="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button x:Name="BtnBukaProduk" Content="Lihat Daftar Produk" Padding="10,5" Click="BtnBukaProduk_Click"/>
                        <Button x:Name="BtnSync" Content="Sync Sekarang" Padding="10,5" Margin="10,0,0,0" Click="BtnSync_Click"/>
                    </StackPanel>

                    <Separator Margin="0,0,0,10"/>

                    <TextBlock Text="Status Sinkronisasi:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TeksStatus" IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                             FontStyle="Italic" TextWrapping="Wrap" Text="Siap."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Informasi Sistem" Grid.Column="2" Padding="10">
                <StackPanel>
                    <TextBlock Text="• Mode Offline-First Aktif" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Semua perubahan tersimpan secara lokal terlebih dahulu di komputer Anda." TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>

                    <TextBlock Text="• Sinkronisasi Cloud" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Tekan F5 atau tombol Sync untuk menyinkronkan data lokal dengan server Supabase." TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>