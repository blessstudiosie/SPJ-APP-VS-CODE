<Window x:Class="SPJ_APP.View.AutoPurchaseOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PO Otomatis dengan Rasio Qty" Height="740" Width="920" WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="📦 Purchase Order (PO) Otomatis" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Masukkan total qty target keseluruhan, aplikasi akan membagi qty per item berdasarkan rasio." Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Row 1: Target Qty & PO Notes -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Total Target Qty" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                    <TextBox x:Name="InputTotalTarget" Margin="0,4,0,0" Padding="10,6" MinHeight="36" VerticalContentAlignment="Center" TextChanged="InputTotalTarget_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Catatan PO" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                    <TextBox x:Name="InputCatatan" Margin="0,4,0,0" Padding="10,6" MinHeight="36" VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button x:Name="TombolHitung" Grid.Column="2" Content="⚡ Hitung Rasio" VerticalAlignment="Bottom" Height="36" Padding="14,0" Background="#4F46E5" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="TombolHitung_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Row 2: Search Filters with Autocomplete (Nama Barang & Kategori) -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <!-- Filter 1: Nama Barang with Autocomplete -->
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="🔍 Cari Nama Barang" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                    <Grid Margin="0,4,0,0">
                        <TextBox x:Name="TxtCariNamaBarang" 
                                  Padding="10,6" 
                                  MinHeight="36" 
                                  VerticalContentAlignment="Center"
                                  GotFocus="TxtCariNamaBarang_GotFocus"
                                  TextChanged="TxtCariNamaBarang_TextChanged" 
                                  PreviewKeyDown="TxtCariNamaBarang_PreviewKeyDown"/>
                        <TextBlock Text="Ketik nama barang..." Foreground="#94A3B8" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtCariNamaBarang}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Autocomplete Suggestions Popup -->
                        <Popup x:Name="PopupNamaBarangSuggestions" 
                               PlacementTarget="{Binding ElementName=TxtCariNamaBarang}" 
                               Placement="Bottom" 
                               AllowsTransparency="True" 
                               StaysOpen="False" 
                               Focusable="False">
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" MaxHeight="180" Width="{Binding ActualWidth, ElementName=TxtCariNamaBarang}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.15"/>
                                </Border.Effect>
                                <ListBox x:Name="ListNamaBarangSuggestions" 
                                         BorderThickness="0" 
                                         SelectionChanged="ListNamaBarangSuggestions_SelectionChanged" 
                                         Cursor="Hand"/>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Filter 2: Kategori Barang with Autocomplete -->
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="🏷️ Cari Kategori" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                    <Grid Margin="0,4,0,0">
                        <TextBox x:Name="TxtCariKategori" 
                                  Padding="10,6" 
                                  MinHeight="36" 
                                  VerticalContentAlignment="Center"
                                  GotFocus="TxtCariKategori_GotFocus"
                                  TextChanged="TxtCariKategori_TextChanged" 
                                  PreviewKeyDown="TxtCariKategori_PreviewKeyDown"/>
                        <TextBlock Text="Ketik nama kategori..." Foreground="#94A3B8" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtCariKategori}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Autocomplete Suggestions Popup -->
                        <Popup x:Name="PopupKategoriSuggestions" 
                               PlacementTarget="{Binding ElementName=TxtCariKategori}" 
                               Placement="Bottom" 
                               AllowsTransparency="True" 
                               StaysOpen="False" 
                               Focusable="False">
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" MaxHeight="180" Width="{Binding ActualWidth, ElementName=TxtCariKategori}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.15"/>
                                </Border.Effect>
                                <ListBox x:Name="ListKategoriSuggestions" 
                                         BorderThickness="0" 
                                         SelectionChanged="ListKategoriSuggestions_SelectionChanged" 
                                         Cursor="Hand"/>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Reset Filter Button -->
                <Button x:Name="TombolResetFilter" 
                        Grid.Column="2" 
                        Content="🔄 Reset" 
                        VerticalAlignment="Bottom" 
                        Height="36" 
                        Padding="14,0" 
                        Background="#F1F5F9" 
                        Foreground="#334155" 
                        BorderBrush="#CBD5E1" 
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="TombolResetFilter_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Row 3: Items DataGrid -->
        <DataGrid x:Name="TabelItem" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                  AlternatingRowBackground="#F8FAFC" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Pilih" Binding="{Binding IsSelected, Mode=TwoWay}" Width="50"/>
                <DataGridTextColumn Header="Produk" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Qty Ratio Default" Binding="{Binding QtyRatio, StringFormat={}{0:N0}}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="Qty Hasil Pembagian" Binding="{Binding QtyCalculated, StringFormat={}{0:N0}}" Width="150"/>
                <DataGridTextColumn Header="Catatan Item" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 4: Footer Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TombolBatal" Content="Batal" Padding="16,8" Margin="0,0,10,0" Height="36" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" FontWeight="SemiBold" Cursor="Hand" Click="TombolBatal_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="TombolSimpan" Content="💾 Simpan PO" Padding="20,8" Height="36" Background="#16A34A" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="TombolSimpan_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
