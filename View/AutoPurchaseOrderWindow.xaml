<Window x:Class="SPJ_APP.View.AutoPurchaseOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PO Otomatis dengan Rasio Qty" Height="680" Width="820" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="PO Barang Otomatis" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Masukkan total qty target keseluruhan, aplikasi akan membagi qty per item berdasarkan rasio." Foreground="Gray"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Total Qty Keseluruhan Target"/>
                <TextBox x:Name="InputTotalTarget" Margin="0,2,0,0" TextChanged="InputTotalTarget_TextChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Catatan PO"/>
                <TextBox x:Name="InputCatatan" Margin="0,2,0,0"/>
            </StackPanel>

            <Button x:Name="TombolHitung" Grid.Column="2" Content="Hitung Rasio" VerticalAlignment="Bottom" Height="26" Click="TombolHitung_Click"/>
        </Grid>

        <DataGrid x:Name="TabelItem" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  AlternatingRowBackground="#F5F5F5" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Pilih" Binding="{Binding IsSelected, Mode=TwoWay}" Width="50"/>
                <DataGridTextColumn Header="Produk" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Qty Ratio Default" Binding="{Binding QtyRatio, StringFormat={}{0:N0}}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Qty Hasil Pembagian" Binding="{Binding QtyCalculated, StringFormat={}{0:N0}}" Width="140"/>
                <DataGridTextColumn Header="Catatan Item" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TombolBatal" Content="Batal" Padding="15,5" Margin="0,0,10,0" Click="TombolBatal_Click"/>
            <Button x:Name="TombolSimpan" Content="Simpan PO" Padding="15,5" Click="TombolSimpan_Click"/>
        </StackPanel>
    </Grid>
</Window>
