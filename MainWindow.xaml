<Window x:Class="SPJ_APP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPJ APP" Height="700" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Google Sheets Menu Theme Resources -->
        <!-- Separator Style -->
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Background" Value="#DADCE0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#DADCE0" Margin="0,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Google Sheets Style MenuItem ControlTemplate -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#3C4043"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Roboto"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="templateRoot" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}" 
                                Margin="{TemplateBinding Margin}"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="GridContainer" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="Icon" ContentSource="Icon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" Margin="2,0"/>

                                <Popup x:Name="PART_Popup" 
                                       AllowsTransparency="True" 
                                       Focusable="False" 
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                       PopupAnimation="Fade" 
                                       Placement="Bottom"
                                       VerticalOffset="2"
                                       HorizontalOffset="-2">
                                    <Border x:Name="SubMenuBorder" 
                                            Background="#FFFFFF" 
                                            BorderBrush="#DADCE0" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="0,6" 
                                            Margin="0,0,8,8">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#3C4043" Opacity="0.18"/>
                                        </Border.Effect>
                                        <ScrollViewer x:Name="SubMenuScrollViewer" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                                            <Grid RenderOptions.ClearTypeHint="Enabled">
                                                <Canvas Height="0" Width="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <Rectangle x:Name="OpaqueRect" Fill="{Binding Background, ElementName=SubMenuBorder}" Height="{Binding ActualHeight, ElementName=SubMenuBorder}" Width="{Binding ActualWidth, ElementName=SubMenuBorder}"/>
                                                </Canvas>
                                                <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" KeyboardNavigation.TabNavigation="Cycle"/>
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Role Triggers -->
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="Margin" Value="1,0"/>
                                <Setter TargetName="templateRoot" Property="CornerRadius" Value="4"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="Margin" Value="1,0"/>
                                <Setter TargetName="templateRoot" Property="CornerRadius" Value="4"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter Property="Padding" Value="16,7,24,7"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter TargetName="templateRoot" Property="CornerRadius" Value="0"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter Property="Padding" Value="16,7,24,7"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter TargetName="templateRoot" Property="CornerRadius" Value="0"/>
                            </Trigger>

                            <!-- Icon Visibility -->
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                            </Trigger>

                            <!-- Mouse Over Triggers (Google Sheets Style) -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Role" Value="TopLevelHeader"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="templateRoot" Property="Background" Value="#F1F3F4"/>
                                <Setter Property="Foreground" Value="#202124"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Role" Value="TopLevelItem"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="templateRoot" Property="Background" Value="#F1F3F4"/>
                                <Setter Property="Foreground" Value="#202124"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Role" Value="SubmenuItem"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="templateRoot" Property="Background" Value="#F1F3F4"/>
                                <Setter Property="Foreground" Value="#202124"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Role" Value="SubmenuHeader"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="templateRoot" Property="Background" Value="#F1F3F4"/>
                                <Setter Property="Foreground" Value="#202124"/>
                            </MultiTrigger>

                            <!-- Submenu Open / Active Tab Trigger -->
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="templateRoot" Property="Background" Value="#E8F0FE"/>
                                <Setter Property="Foreground" Value="#1A73E8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>

                            <!-- Disabled Trigger -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#80868B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid>

        <DockPanel x:Name="MainContentPanel">
            <!-- Modern Bottom Status Bar -->
            <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,6">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Siap Digunakan" Foreground="#475569" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SyncStatusTextRight" Text="" Foreground="#4F46E5" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <ProgressBar x:Name="SyncProgressBar" Width="110" Height="8" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>

            
            <!-- Modern Top Header Navigation Bar -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- App Logo & Brand Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo_spj.png" Height="32" Width="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SPJ APP" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                            <TextBlock Text="CV. Sarana Prima Jaya" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                        <Border Width="1" Height="24" Background="#E2E8F0" Margin="14,0"/>
                    </StackPanel>

                    <!-- Top Menu Links with Named Items for Active State -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Menu Background="Transparent" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                            <MenuItem x:Name="NavBeranda" Header="🏠 Beranda" Click="MenuBeranda_Click" Padding="10,6"/>
                            <MenuItem x:Name="NavProduk" Header="📦 Produk" Padding="10,6">
                                <MenuItem Header="Daftar Produk &amp; Stok" Click="MenuProduk_Click"/>
                            </MenuItem>
                            <MenuItem x:Name="NavMasterData" Header="👥 Master Data" Padding="10,6">
                                <MenuItem Header="Daftar Sales" Click="MenuSalesPerson_Click"/>
                                <MenuItem Header="Daftar Customer / Toko" Click="MenuCustomer_Click"/>
                            </MenuItem>
                            <MenuItem x:Name="NavTransaksi" Header="📑 Transaksi" Padding="10,6">
                                <MenuItem Header="Purchase Order (PO) Otomatis..." Click="MenuAutoPO_Click"/>
                                <MenuItem Header="Daftar Nota Penjualan" Click="MenuTransaksi_Click"/>
                                <MenuItem Header="💳 Konfirmasi Pembayaran..." Click="MenuKonfirmasiPembayaran_Click"/>
                            </MenuItem>
                            <MenuItem x:Name="NavInbox" Header="📥 Inbox Mobile" Padding="10,6">
                                <MenuItem Header="Inbox Sales Order (Mobile SO)" Click="MenuInboxSO_Click"/>
                                <MenuItem Header="Inbox Kunjungan Sales (Check-in)" Click="MenuInboxKunjungan_Click"/>
                            </MenuItem>
                            <MenuItem x:Name="NavPengiriman" Header="🚚 Pengiriman" Click="MenuPengiriman_Click" Padding="10,6"/>

                            <MenuItem x:Name="NavLaporan" Header="📊 Laporan" Click="MenuLaporan_Click" Padding="10,6"/>
                            <MenuItem x:Name="NavPengaturan" Header="⚙️ Pengaturan" Padding="10,6">
                                <MenuItem Header="🔑 Ubah Password Saya..." Click="MenuUbahPassword_Click"/>
                                <MenuItem Header="⚙️ Pengaturan System &amp; Data..." Click="MenuPengaturan_Click"/>
                                <Separator/>
                                <MenuItem Header="🚪 Log Out (Keluar Akun)..." Click="MenuLogout_Click" Foreground="#EF4444" FontWeight="Bold"/>
                            </MenuItem>

                            <MenuItem x:Name="MenuDeveloperTools" Header="🛠️ Developer Tools" Visibility="Collapsed" Padding="10,6">
                                <MenuItem Header="Database Inspector (UI Local DB)" Click="MenuDatabaseInspector_Click"/>
                                <MenuItem Header="Import / Export Data Maintenance" Click="MenuPengaturan_Click"/>
                            </MenuItem>
                            <MenuItem Header="🔄 Sync Sekarang" Click="MenuSync_Click" Foreground="#4F46E5" FontWeight="Bold" Padding="12,6"/>
                        </Menu>
                    </ScrollViewer>

                    <!-- Right User Profile & Log Out Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="TombolBantuanSop" 
                                Content="❓ SOP Penjualan" 
                                ToolTip="Lihat Alur Kerja Operasional Penjualan &amp; Pengakuan Omset Sah (SOP)" 
                                Padding="10,5" 
                                Height="32" 
                                Background="#EEF2FF" 
                                Foreground="#4F46E5" 
                                BorderBrush="#C7D2FE" 
                                FontWeight="Bold" 
                                Cursor="Hand"
                                Margin="0,0,8,0" 
                                Click="TombolBantuanSop_Click"/>

                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤 " FontSize="12"/>
                                <TextBlock x:Name="TeksUserBadge" Text="blessstudiosie (DEVELOPER)" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="TombolLogout" Content="🚪 Log Out" Padding="10,5" Height="32" Background="#FEF2F2" Foreground="#EF4444" BorderBrush="#FCA5A5" FontWeight="Bold" Click="MenuLogout_Click"/>
                    </StackPanel>

                </Grid>
            </Border>


            <!-- Main Content Container -->
            <ContentControl x:Name="AreaKonten" Margin="16"/>
        </DockPanel>
        
        <!-- Blocking Sync / Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="#B30F172A" Visibility="Collapsed">
            <Border Background="White" CornerRadius="16" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⚡ SPJ APP SYNC" Foreground="#4F46E5" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingHeaderTitle" Text="Sedang Melakukan Sinkronisasi Data..." Foreground="#0F172A" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,4"/>
                    <TextBlock x:Name="LoadingHeaderSubtitle" Text="Mohon tunggu hingga seluruh proses selesai." Foreground="#64748B" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <ProgressBar IsIndeterminate="True" Width="260" Height="8" Margin="0,0,0,14"/>
                    <TextBlock x:Name="LoadingStatusText" Text="Memuat data dari server..." Foreground="#475569" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom-Right Toast Notification Popup Container -->

        <Border x:Name="ToastNotificationCard" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Margin="0,0,24,45" 
                Background="#0F172A" 
                BorderBrush="#6366F1" 
                BorderThickness="1.5" 
                CornerRadius="12" 
                Padding="16,12" 
                Width="360" 
                Visibility="Collapsed" 
                Cursor="Hand"
                MouseLeftButtonDown="ToastNotificationCard_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.35"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Background="#4F46E5" CornerRadius="20" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="🔔" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ToastTitleText" Text="Data Baru Diterima!" Foreground="White" FontSize="13" FontWeight="Bold"/>
                    <TextBlock x:Name="ToastMessageText" Text="Ada data baru yang diunduh dari server." Foreground="#94A3B8" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock Text="👉 Klik di sini untuk membuka halaman (Shortcut)" Foreground="#A5B4FC" FontSize="10.5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Width="24" Height="24" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="12" FontWeight="Bold" VerticalAlignment="Top" Click="CloseToast_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>



