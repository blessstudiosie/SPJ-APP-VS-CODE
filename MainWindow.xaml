<Window x:Class="SPJ_APP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPJ APP" Height="600" Width="1000"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">
    <Grid>
        <DockPanel x:Name="MainContentPanel">
            <StatusBar DockPanel.Dock="Bottom">
                <StatusBarItem>
                    <TextBlock x:Name="StatusText" Text="Ready"/>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <ProgressBar x:Name="SyncProgressBar" Width="100" Height="15" IsIndeterminate="True" Visibility="Collapsed"/>
                </StatusBarItem>
            </StatusBar>
            
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_Beranda" Click="MenuBeranda_Click"/>
                <MenuItem Header="_Produk">
                    <MenuItem Header="Daftar Produk" Click="MenuProduk_Click"/>
                </MenuItem>
                <MenuItem Header="_Master Data">
                    <MenuItem Header="Sales" Click="MenuSalesPerson_Click"/>
                    <MenuItem Header="Customer" Click="MenuCustomer_Click"/>
                </MenuItem>
                <MenuItem Header="_Transaksi">
                    <MenuItem Header="PO Otomatis..." Click="MenuAutoPO_Click"/>
                    <MenuItem Header="Daftar Nota" Click="MenuTransaksi_Click"/>
                </MenuItem>
                <MenuItem Header="_Inbox Mobile">
                    <MenuItem Header="Inbox Sales Order" Click="MenuInboxSO_Click"/>
                    <MenuItem Header="Inbox Kunjungan Sales" Click="MenuInboxKunjungan_Click"/>
                </MenuItem>
                <MenuItem Header="_Pembayaran" Click="MenuKonfirmasiPembayaran_Click"/>
    			<MenuItem Header="_Pengiriman" Click="MenuPengiriman_Click"/>
                <MenuItem Header="_Laporan" Click="MenuLaporan_Click"/>
                <MenuItem Header="_Pengaturan" Click="MenuPengaturan_Click"/>
                <MenuItem x:Name="MenuDeveloperTools" Header="_Developer Tools" Visibility="Collapsed">
                    <MenuItem Header="Database Inspector (UI Local DB)" Click="MenuDatabaseInspector_Click"/>
                    <MenuItem Header="Import / Export Data Maintenance" Click="MenuPengaturan_Click"/>
                </MenuItem>
                <MenuItem Header="_Sync Sekarang" Click="MenuSync_Click" FontWeight="Bold"/>
            </Menu>


            <ContentControl x:Name="AreaKonten"/>
        </DockPanel>
        
        <Grid x:Name="LoadingOverlay" Background="#80000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Inisialisasi Aplikasi" Foreground="White" FontSize="24" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="250" Height="20" Margin="0,15,0,5"/>
                <TextBlock x:Name="LoadingStatusText" Text="Memulai..." Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
