<Window x:Class="SPJ_APP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPJ APP" Height="700" Width="1120"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">
    <Grid>
        <DockPanel x:Name="MainContentPanel">
            <!-- Modern Bottom Status Bar -->
            <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,6">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Siap Digunakan" Foreground="#475569" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SyncStatusTextRight" Text="" Foreground="#4F46E5" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <ProgressBar x:Name="SyncProgressBar" Width="110" Height="8" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>

            
            <!-- Modern Top Header Navigation Bar -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- App Logo & Brand Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo_spj.png" Height="32" Width="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SPJ APP" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                            <TextBlock Text="CV. Sarana Prima Jaya" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                        <Border Width="1" Height="24" Background="#E2E8F0" Margin="14,0"/>
                    </StackPanel>

                    <!-- Top Menu Links with Named Items for Active State -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Menu Background="Transparent" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                            <MenuItem x:Name="NavBeranda" Header="🏠 Beranda" Click="MenuBeranda_Click" Padding="10,6"/>
                            <MenuItem x:Name="NavProduk" Header="📦 Produk" Padding="10,6">
                                <MenuItem Header="Daftar Produk &amp; Stok" Click="MenuProduk_Click"/>
                            </MenuItem>
                            <MenuItem x:Name="NavMasterData" Header="👥 Master Data" Padding="10,6">
                                <MenuItem Header="Daftar Sales" Click="MenuSalesPerson_Click"/>
                                <MenuItem Header="Daftar Customer / Toko" Click="MenuCustomer_Click"/>
                            </MenuItem>
                            <MenuItem x:Name="NavTransaksi" Header="📑 Transaksi" Padding="10,6">
                                <MenuItem Header="Purchase Order (PO) Otomatis..." Click="MenuAutoPO_Click"/>
                                <MenuItem Header="Daftar Nota Penjualan" Click="MenuTransaksi_Click"/>
                                <MenuItem Header="💳 Konfirmasi Pembayaran..." Click="MenuKonfirmasiPembayaran_Click"/>
                            </MenuItem>
                            <MenuItem x:Name="NavInbox" Header="📥 Inbox Mobile" Padding="10,6">
                                <MenuItem Header="Inbox Sales Order (Mobile SO)" Click="MenuInboxSO_Click"/>
                                <MenuItem Header="Inbox Kunjungan Sales (Check-in)" Click="MenuInboxKunjungan_Click"/>
                            </MenuItem>
                            <MenuItem x:Name="NavPengiriman" Header="🚚 Pengiriman" Click="MenuPengiriman_Click" Padding="10,6"/>

                            <MenuItem x:Name="NavLaporan" Header="📊 Laporan" Click="MenuLaporan_Click" Padding="10,6"/>
                            <MenuItem x:Name="NavPengaturan" Header="⚙️ Pengaturan" Padding="10,6">
                                <MenuItem Header="🔑 Ubah Password Saya..." Click="MenuUbahPassword_Click"/>
                                <MenuItem Header="⚙️ Pengaturan System &amp; Data..." Click="MenuPengaturan_Click"/>
                                <Separator/>
                                <MenuItem Header="🚪 Log Out (Keluar Akun)..." Click="MenuLogout_Click" Foreground="#EF4444" FontWeight="Bold"/>
                            </MenuItem>

                            <MenuItem x:Name="MenuDeveloperTools" Header="🛠️ Developer Tools" Visibility="Collapsed" Padding="10,6">
                                <MenuItem Header="Database Inspector (UI Local DB)" Click="MenuDatabaseInspector_Click"/>
                                <MenuItem Header="Import / Export Data Maintenance" Click="MenuPengaturan_Click"/>
                            </MenuItem>
                            <MenuItem Header="🔄 Sync Sekarang" Click="MenuSync_Click" Foreground="#4F46E5" FontWeight="Bold" Padding="12,6"/>
                        </Menu>
                    </ScrollViewer>

                    <!-- Right User Profile & Log Out Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤 " FontSize="12"/>
                                <TextBlock x:Name="TeksUserBadge" Text="blessstudiosie (DEVELOPER)" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="TombolLogout" Content="🚪 Log Out" Padding="10,5" Height="32" Background="#FEF2F2" Foreground="#EF4444" BorderBrush="#FCA5A5" FontWeight="Bold" Click="MenuLogout_Click"/>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- Main Content Container -->
            <ContentControl x:Name="AreaKonten" Margin="16"/>
        </DockPanel>
        
        <!-- Blocking Sync / Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="#B30F172A" Visibility="Collapsed">
            <Border Background="White" CornerRadius="16" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⚡ SPJ APP SYNC" Foreground="#4F46E5" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingHeaderTitle" Text="Sedang Melakukan Sinkronisasi Data..." Foreground="#0F172A" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,4"/>
                    <TextBlock x:Name="LoadingHeaderSubtitle" Text="Mohon tunggu hingga seluruh proses selesai." Foreground="#64748B" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <ProgressBar IsIndeterminate="True" Width="260" Height="8" Margin="0,0,0,14"/>
                    <TextBlock x:Name="LoadingStatusText" Text="Memuat data dari server..." Foreground="#475569" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>


