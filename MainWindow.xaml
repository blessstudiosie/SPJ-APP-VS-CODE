<Window x:Class="SPJ_APP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPJ APP" Height="700" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">
    <Grid>
        <DockPanel x:Name="MainContentPanel">
            <!-- Modern Bottom Status Bar -->
            <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,6">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Siap Digunakan" Foreground="#475569" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <ProgressBar x:Name="SyncProgressBar" Width="120" Height="10" IsIndeterminate="True" Visibility="Collapsed"/>
                </StatusBarItem>
            </StatusBar>
            
            <!-- Modern Top Header Navigation Bar -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- App Logo & Brand Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo_spj.png" Height="32" Width="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SPJ APP" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                            <TextBlock Text="CV. Sarana Prima Jaya" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                        <Border Width="1" Height="24" Background="#E2E8F0" Margin="14,0"/>
                    </StackPanel>

                    <!-- Top Menu Links -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Menu Background="Transparent" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                            <MenuItem Header="🏠 Beranda" Click="MenuBeranda_Click" Padding="8,6"/>
                            <MenuItem Header="📦 Produk" Padding="8,6">
                                <MenuItem Header="Daftar Produk &amp; Stok" Click="MenuProduk_Click"/>
                            </MenuItem>
                            <MenuItem Header="👥 Master Data" Padding="8,6">
                                <MenuItem Header="Daftar Sales" Click="MenuSalesPerson_Click"/>
                                <MenuItem Header="Daftar Customer / Toko" Click="MenuCustomer_Click"/>
                            </MenuItem>
                            <MenuItem Header="📑 Transaksi" Padding="8,6">
                                <MenuItem Header="Purchase Order (PO) Otomatis..." Click="MenuAutoPO_Click"/>
                                <MenuItem Header="Daftar Nota Penjualan" Click="MenuTransaksi_Click"/>
                            </MenuItem>
                            <MenuItem Header="📥 Inbox Mobile" Padding="8,6">
                                <MenuItem Header="Inbox Sales Order (Mobile SO)" Click="MenuInboxSO_Click"/>
                                <MenuItem Header="Inbox Kunjungan Sales (Check-in)" Click="MenuInboxKunjungan_Click"/>
                            </MenuItem>
                            <MenuItem Header="💳 Pembayaran" Click="MenuKonfirmasiPembayaran_Click" Padding="8,6"/>
                            <MenuItem Header="🚚 Pengiriman" Click="MenuPengiriman_Click" Padding="8,6"/>
                            <MenuItem Header="📊 Laporan" Click="MenuLaporan_Click" Padding="8,6"/>
                            <MenuItem Header="⚙️ Pengaturan" Click="MenuPengaturan_Click" Padding="8,6"/>
                            <MenuItem x:Name="MenuDeveloperTools" Header="🛠️ Developer Tools" Visibility="Collapsed" Padding="8,6">
                                <MenuItem Header="Database Inspector (UI Local DB)" Click="MenuDatabaseInspector_Click"/>
                                <MenuItem Header="Import / Export Data Maintenance" Click="MenuPengaturan_Click"/>
                            </MenuItem>
                            <MenuItem Header="🔄 Sync Sekarang" Click="MenuSync_Click" Foreground="#4F46E5" FontWeight="Bold" Padding="10,6"/>
                        </Menu>
                    </ScrollViewer>
                </Grid>
            </Border>


            <!-- Main Content Container -->
            <ContentControl x:Name="AreaKonten" Margin="16"/>
        </DockPanel>
        
        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="#990F172A" Visibility="Collapsed">
            <Border Background="White" CornerRadius="16" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.15"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="SPJ APP" Foreground="#4F46E5" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Inisialisasi &amp; Sinkronisasi Data..." Foreground="#475569" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                    <ProgressBar IsIndeterminate="True" Width="220" Height="8" Margin="0,0,0,12"/>
                    <TextBlock x:Name="LoadingStatusText" Text="Memuat..." Foreground="#64748B" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

